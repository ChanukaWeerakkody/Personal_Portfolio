# Contact form (https://www.emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: serverless proxy for LLM-backed chat (see api/chat.js). Leave empty to use the built-in local assistant.
VITE_CHAT_ENDPOINT=/api/chat

# GitHub username used by the live stats section
VITE_GITHUB_USER=chanukaweerakkody
